# Public site URL. Used for canonical URLs, sitemap, and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.bayittitle.com

# Supabase — website project ONLY (ref ajauxndpqllrsfivvurj).
# NEVER point these at the "Bayit" production project (ref rsdhvyutynygzgtzzljd).
# That project holds live transactions, escrow and banking data and is
# deliberately unreachable from this codebase.
SUPABASE_URL=https://ajauxndpqllrsfivvurj.supabase.co

# Service-role key. Server-side only — never prefixed NEXT_PUBLIC_.
# Reads reviews/locations at build time and writes leads/orders at runtime.
SUPABASE_SERVICE_ROLE_KEY=

# Fail the build unless all 67 counties load. Without Supabase the county list
# falls back to six, and a deploy built that way ships six county pages and
# drops the other 61 from the sitemap. The production deployment refuses that
# on its own (VERCEL_ENV=production); set this to 1 in any other build that has
# the key above and should be held to the same rule. Leave it unset in a build
# that deliberately runs without credentials.
REQUIRE_LOCATIONS=

# Where form notifications are sent. Without a key, submissions still persist
# to Supabase and the notification is skipped — which in production means
# nobody in the office hears about an order, so there it is logged as an error
# on every submission and /api/health answers 503. A key scoped to sending
# only is enough, and is the scope to give it.
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=website@bayittitle.com

# Cloudflare Turnstile on the order, quote, contact and contract forms.
# Optional, and all or nothing: with both unset no script loads, the CSP is
# unchanged and the forms behave exactly as before. With both set the widget
# renders above each form's button, the Route Handlers verify its token, and
# the CSP allows challenges.cloudflare.com. Setting only one does nothing —
# the server enforces the check only when it has both, so a half-configured
# deploy cannot refuse every real order.
#
# The site key is public and inlined into the page at build time, so changing
# it takes a redeploy. The secret is server-side only.
# Cloudflare dashboard -> Turnstile -> Add site (widget mode: Managed).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# The daily purge of uploaded documents (vercel.json -> /api/cron/purge).
# Leaving this unset leaves the purge off: Vercel sends it as a bearer token on
# every scheduled call, and without it the endpoint refuses to run. Nothing the
# site says promises a purge, so whether to switch it on, and at what ages, is
# the firm's call with its counsel. Any long random string:
# `openssl rand -hex 32`.
CRON_SECRET=

# With the purge on: days a contract sent for pricing from /estimate stays in
# storage before it is deleted. Optional, default 30. Order documents go on the
# purge_after date stamped on each row, 90 days by default (lib/documents.ts
# RETENTION_DAYS and the table's trigger).
QUOTE_RETENTION_DAYS=

# Site ownership tokens. Neither is a secret — both are published in the page
# head. Set them on the production environment only: a Search Console property
# is per-origin, and verifying the Vercel preview hostname would report on a
# site nobody is meant to find.
#
# Google: Search Console -> Add property -> HTML tag. DNS TXT verification is
# the better method if you are already in the domain's DNS; then leave this
# unset. Bing: Webmaster Tools -> Add site -> Meta tag (it can also import an
# already-verified Search Console property, which skips this entirely).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Statewide address lookup on /estimate. Optional, and the site works without
# it: twenty-two counties publish a roll or address service this code searches
# directly (lib/county-rolls.ts), and the other forty-five fall back to naming
# the county and letting the reader type the value in.
#
# With a key, every Florida address can be searched and priced. The key is
# Esri's, from an ArcGIS Location Platform account — arcgis.com/, Location
# Platform, "API keys" — scoped to the geocoding service and nothing else.
# Esri's free tier covers a few thousand geocodes a month at the time of
# writing; check their current pricing before relying on it, because the
# estimator geocodes once per property somebody picks, not once per keystroke.
#
# Two conditions of the cheaper geocode are enforced in lib/geocoder.ts rather
# than left to whoever sets this: the result is requested with forStorage=false
# and is never cached or written down.
#
# /estimate is a static page, so the sentence it opens with — how much of
# Florida it can price — is decided when the site is built. Setting this key
# takes a redeploy to show up there; the lookups themselves pick it up as soon
# as the environment has it.
#
# Server-side only. Never prefixed NEXT_PUBLIC_: a key in the page is a key
# anybody can spend.
ARCGIS_API_KEY=

# How many billed geocodes a day the lookup will make before it stops for the
# day (default 1000). Counted in each server instance's memory, so on Vercel it
# bounds a runaway rather than a budget — set the budget itself on the Esri
# account, and a rate rule on /api/* in the Vercel firewall.
ESRI_DAILY_GEOCODE_CAP=

# Signs the value lookups /api/property-search hands out, so /api/parcel-value
# runs only lookups this site offered (a random string of 32 bytes or more:
# `openssl rand -base64 32`). Optional: without it a key is derived from
# SUPABASE_SERVICE_ROLE_KEY, which is also server-side only. Rotating either
# one only expires the dropdowns open at that moment.
LOOKUP_SIGNING_SECRET=
