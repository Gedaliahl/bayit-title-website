# Public site URL. Used for canonical URLs, sitemap, and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://bayittitle.com

# Supabase — website project ONLY (ref ajauxndpqllrsfivvurj).
# NEVER point these at the "Bayit" production project (ref rsdhvyutynygzgtzzljd).
# That project holds live transactions, escrow and banking data and is
# deliberately unreachable from this codebase.
SUPABASE_URL=https://ajauxndpqllrsfivvurj.supabase.co

# Service-role key. Server-side only — never prefixed NEXT_PUBLIC_.
# Reads reviews/locations at build time and writes leads/orders at runtime.
SUPABASE_SERVICE_ROLE_KEY=

# Where form notifications are sent. Optional: without a key, submissions
# still persist to Supabase and the notification is skipped.
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=website@bayittitle.com
