{
  "ci": {
    "collect": {
      "startServerCommand": "npm run start -- -p 3207",
      "startServerReadyPattern": "Ready",
      "url": [
        "http://localhost:3207/estimate",
        "http://localhost:3207/counties/broward-county",
        "http://localhost:3207/title-problems/open-permits-before-closing-florida",
        "http://localhost:3207/order"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--headless=new --no-sandbox",
        "skipAudits": ["is-crawlable"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["warn", { "minScore": 0.95 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
